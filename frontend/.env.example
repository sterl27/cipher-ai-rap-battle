# Musaix Pro - Environment Variables
# Copy this file to .env.local and fill in your values
# REQUIRED variables must be set for the app to function

# ────── REQUIRED ──────
# Gemini API (for Alic3X PRO) - Required for AI features
GEMINI_API_KEY=your_gemini_api_key_here

# Google Custom Search (for Alic3X Web Search) - Required for web search feature
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_CX=your_programmable_search_engine_id_here

# ────── OPTIONAL ──────
# Firebase (optional, for authentication and storage)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Supabase (optional, for PostgreSQL data)
# Public client vars (safe for browser)
NUXT_PUBLIC_SUPABASE_URL=https://your_project.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Server-only var (NEVER expose in client code)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: protect server health endpoint in production
HEALTH_CHECK_SECRET=your_internal_health_secret

# ────── PUBLIC CONFIG ──────
NUXT_PUBLIC_APP_NAME=Musaix Pro
NUXT_PUBLIC_APP_VERSION=1.0.0
