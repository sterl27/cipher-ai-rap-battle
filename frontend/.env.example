# Musaix Pro - Environment Variables
# Copy this file to .env.local and fill in your values
# REQUIRED variables must be set for the app to function

# ────── REQUIRED ──────
# Gemini API (for Alic3X PRO) - Required for AI features
GEMINI_API_KEY=your_gemini_api_key_here

# ────── OPTIONAL ──────
# Firebase (optional, for authentication and storage)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Supabase (optional, for PostgreSQL data)
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# ────── PUBLIC CONFIG ──────
NUXT_PUBLIC_APP_NAME=Musaix Pro
NUXT_PUBLIC_APP_VERSION=1.0.0
